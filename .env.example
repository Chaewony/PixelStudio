# 기존 Discord 설정: 실제 값은 .env에만 입력합니다.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
# 비워두면 기존 소유자 전용 정책을 유지합니다.
DISCORD_ALLOWED_CHANNEL_ID=

# LangChain 모델 공급자: openai / anthropic / google_genai
MODEL_PROVIDER=openai
# 공통 모델 ID. OpenAI에서 비워두면 기존 OPENAI_MODEL을 사용합니다.
MODEL_NAME=
# 선택한 공급자의 키만 입력합니다. 다른 공급자의 키로 대체하지 않습니다.
OPENAI_API_KEY=
# 이미지 입력과 function calling을 지원하는 API 모델 ID를 입력합니다.
OPENAI_MODEL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# 기존 Aseprite 확장과 같은 패키지 버전을 사용합니다.
ASEPRITE_MCP_PACKAGE=@pebbly/aseprite-ai-artist@0.8.2
MCP_TIMEOUT_SECONDS=30
JOB_TIMEOUT_SECONDS=480
MAX_AGENT_ROUNDS=16
MAX_TOOL_CALLS=32
MAX_OUTPUT_TOKENS=6000
# Planner·Artist·Reviewer·Fixer와 형식 교정을 모두 합친 모델 요청 상한입니다.
MAX_MODEL_CALLS=40
# 최초 제작 이후 수정 가능한 횟수입니다. 0이면 검토만 합니다.
MAX_REVISIONS=2
